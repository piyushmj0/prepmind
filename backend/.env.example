# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ── AI ────────────────────────────────────────────────────────────────────────
GOOGLE_GENAI_API_KEY=<your Google AI Studio API key>

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USER=<your Gmail address>
EMAIL_PASS=<your Gmail app password>

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.netlify.app

# ── Redis (optional — leave blank to disable caching & Redis rate-limiting) ───
# Local:   redis://localhost:6379
# Upstash: rediss://:password@host.upstash.io:port
REDIS_URL=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# AI Gemini endpoints: requests per window per authenticated user
RATE_LIMIT_AI_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_AI_MAX=10

# Auth endpoints: requests per window per IP
RATE_LIMIT_AUTH_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_AUTH_MAX=20

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
